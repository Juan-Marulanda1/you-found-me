APP_NAME=You Found Me API
APP_VERSION=1.0.0
DEBUG=False
DATABASE_URL=postgresql+psycopg://you_found_me:local_dev_password@localhost:5432/you_found_me
HOST=127.0.0.1
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1,::1
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SUPABASE_URL=
# Generate a private key and set it in the backend environment only.
PUBLICATION_CREATION_KEY=replace-with-a-long-random-secret
SUPABASE_SECRET_KEY=
# Compatibilidad temporal con proyectos que aún usan la clave JWT service_role.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images
PRODUCT_IMAGE_MAX_BYTES=5242880
PRODUCT_IMAGE_MAX_COUNT=8
POSTGRES_DB=you_found_me
POSTGRES_USER=you_found_me
POSTGRES_PASSWORD=local_dev_password
